# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# PostgreSQL — local dev: docker compose up -d postgres (host:5433 → container:5432)
DATABASE_URL=postgresql+psycopg://riskora:riskora@localhost:5433/riskora

# Runtime environment: development | production
ENVIRONMENT=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# HS256 secret for JWT signing — change before deploying
JWT_SECRET=change-me-in-development

# Optional: LLM integration (leave blank to use deterministic fallback)
LLM_API_KEY=
LLM_MODEL=

# ── Razorpay TEST MODE (Phase 6) ─────────────────────────────────────────────
# IMPORTANT: TEST MODE credentials ONLY. Never use live/production keys.
#
# Setup:
#   1. Create a free Razorpay account at https://razorpay.com
#   2. Go to Dashboard → Settings → API Keys
#   3. Toggle to "Test Mode" (top-right of the Dashboard)
#   4. Click "Generate Test Mode Key"
#   5. Copy Key ID and Key Secret below
#
# These values are read by the FastAPI backend ONLY.
# They must NEVER appear in Next.js NEXT_PUBLIC_* vars or browser JavaScript.
# The Key Secret and Webhook Secret are never sent to the frontend.
#
# Leave all three blank to run in clearly-labeled "local-demo" mode:
# synthetic payments, no Razorpay API calls, same HMAC-SHA256 verification
# code path (signed with RAZORPAY_DEMO_SECRET).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local demo signing secret — backend only.
# Used exclusively when the Razorpay credentials above are blank.
# Change this for any shared or staging deployment.
RAZORPAY_DEMO_SECRET=riskora-local-demo-secret

# ── Webhook development note ──────────────────────────────────────────────────
# Razorpay cannot deliver webhooks to localhost directly.
# For local webhook testing use a tunnel (e.g. ngrok):
#   ngrok http 8000
# Then set the webhook URL in Razorpay Dashboard → Settings → Webhooks to:
#   https://<your-ngrok-subdomain>.ngrok-free.app/api/v1/webhooks/razorpay
# Copy the "Webhook Secret" from the Razorpay Dashboard into RAZORPAY_WEBHOOK_SECRET.
# NEVER commit tunnel credentials or the ngrok subdomain to source control.
